---
import CodeBlock from './CodeBlock.astro';

interface Props {
  method: 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE';
  path: string;
  description: string;
  statuses?: string[];
  jsonExample?: string;
}

const { method, path, description, statuses = [], jsonExample } = Astro.props;

const methodColors: Record<Props['method'], string> = {
  GET: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/40',
  POST: 'bg-amber-500/15 text-amber-300 border-amber-500/40',
  PUT: 'bg-sky-500/15 text-sky-300 border-sky-500/40',
  PATCH: 'bg-violet-500/15 text-violet-300 border-violet-500/40',
  DELETE: 'bg-rose-500/15 text-rose-300 border-rose-500/40',
};
---

<div class="my-4 rounded-xl border border-slate-800 bg-slate-900/60 p-4">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div class="flex flex-wrap items-center gap-2.5">
      <span class={`px-2.5 py-1 text-xs font-bold font-mono rounded-md border ${methodColors[method]}`}>
        {method}
      </span>
      <code class="text-sm font-mono text-slate-100 bg-slate-950/80 px-2.5 py-1 rounded border border-slate-800">
        {path}
      </code>
    </div>
    {statuses.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {statuses.map((st) => (
          <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">
            {st}
          </span>
        ))}
      </div>
    )}
  </div>
  <p class="mt-2.5 text-sm text-slate-300 leading-relaxed">{description}</p>
  {jsonExample && (
    <div class="mt-3">
      <CodeBlock code={jsonExample} lang="json" filename="Payload / Respuesta JSON" />
    </div>
  )}
</div>

