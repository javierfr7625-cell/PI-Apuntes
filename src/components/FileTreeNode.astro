---
import type { TreeNode, ProjectFile } from '../data/cheatcodeProjects';

interface Props {
  node: TreeNode;
  filesMap: Record<string, ProjectFile>;
  defaultActiveId: string;
}

const { node, filesMap, defaultActiveId } = Astro.props;
---

{node.type === 'folder' ? (
  <details open={node.defaultOpen ?? true} class="group/folder select-none">
    <summary class="flex items-center gap-1.5 px-2 py-1 rounded-md text-xs font-mono text-slate-300 hover:bg-slate-800/70 hover:text-white cursor-pointer list-none">
      <svg class="w-3.5 h-3.5 text-slate-400 transition-transform group-open/folder:rotate-90 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <svg class="w-4 h-4 text-amber-400/90 shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
      </svg>
      <span class="truncate">{node.name}</span>
    </summary>
    <div class="pl-3.5 ml-2 border-l border-slate-800 space-y-0.5 mt-0.5">
      {node.children.map((child) => (
        <Astro.self node={child} filesMap={filesMap} defaultActiveId={defaultActiveId} />
      ))}
    </div>
  </details>
) : (() => {
  const file = filesMap[node.fileId];
  if (!file) return null;
  const active = file.id === defaultActiveId;
  const extColor =
    file.lang === 'java'
      ? 'text-orange-400'
      : file.lang === 'json'
      ? 'text-emerald-400'
      : file.lang === 'xml'
      ? 'text-sky-400'
      : 'text-violet-400';

  return (
    <button
      type="button"
      data-file-trigger={file.id}
      class={`file-tree-btn w-full flex items-center justify-between gap-2 px-2 py-1.5 rounded-md text-left text-xs font-mono transition cursor-pointer ${
        active
          ? 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/35 font-semibold'
          : 'text-slate-300 hover:bg-slate-800/70 hover:text-white border border-transparent'
      }`}
    >
      <span class="flex items-center gap-1.5 min-w-0">
        <span class={`text-[10px] font-bold shrink-0 ${extColor}`}>
          {file.lang === 'java' ? 'J' : file.lang === 'json' ? '{}' : file.lang === 'xml' ? '<>' : '⚙'}
        </span>
        <span class="truncate">{file.name}</span>
      </span>
      {file.badge && (
        <span class="shrink-0 text-[9px] uppercase px-1.5 py-0.5 rounded bg-slate-800 text-slate-400">
          {file.badge}
        </span>
      )}
    </button>
  );
})()}

