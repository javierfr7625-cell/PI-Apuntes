---
import { searchIndex } from '../data/navigation';
import { withBase } from '../utils/paths';

const localizedSearchIndex = searchIndex.map((item) => ({
  ...item,
  href: withBase(item.href),
}));
---

<div class="relative w-full max-w-md" id="search-container">
  <div class="relative">
    <svg
      class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      id="docs-search-input"
      type="search"
      placeholder="Buscar apuntes, @OneToMany, 404, Postman..."
      autocomplete="off"
      class="w-full pl-9 pr-14 py-1.5 text-sm rounded-lg bg-slate-900 border border-slate-700/80 text-slate-100 placeholder-slate-400 focus:outline-none focus:border-cyan-500/70 focus:ring-1 focus:ring-cyan-500/50 transition"
    />
    <kbd class="hidden sm:inline-block absolute right-2.5 top-1/2 -translate-y-1/2 text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">
      Ctrl K
    </kbd>
  </div>

  <div
    id="docs-search-results"
    class="hidden absolute left-0 right-0 mt-2 rounded-xl border border-slate-700/90 bg-slate-900/98 backdrop-blur-md shadow-2xl shadow-black/60 max-h-96 overflow-y-auto z-50 divide-y divide-slate-800/80"
  >
  </div>
</div>

<script define:vars={{ searchIndex: localizedSearchIndex }}>
  const input = document.getElementById('docs-search-input');
  const resultsBox = document.getElementById('docs-search-results');
  const container = document.getElementById('search-container');

  function renderResults(query) {
    if (!resultsBox) return;
    const q = query.trim().toLowerCase();
    if (!q) {
      resultsBox.classList.add('hidden');
      resultsBox.innerHTML = '';
      return;
    }

    const matches = searchIndex.filter((item) => {
      return (
        item.title.toLowerCase().includes(q) ||
        item.description.toLowerCase().includes(q) ||
        item.section.toLowerCase().includes(q) ||
        item.keywords.some((k) => k.includes(q))
      );
    });

    if (matches.length === 0) {
      resultsBox.innerHTML = `
        <div class="p-4 text-sm text-slate-400 text-center">
          No hay resultados para "<span class="text-slate-200">${q}</span>"
        </div>
      `;
      resultsBox.classList.remove('hidden');
      return;
    }

    resultsBox.innerHTML = matches
      .slice(0, 8)
      .map(
        (m) => `
        <a href="${m.href}" class="block px-4 py-3 hover:bg-slate-800/80 transition">
          <div class="flex items-center justify-between gap-2">
            <span class="text-sm font-semibold text-cyan-300">${m.title}</span>
            <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded bg-slate-800 text-slate-400">${m.section}</span>
          </div>
          <p class="text-xs text-slate-400 mt-1 line-clamp-2">${m.description}</p>
        </a>
      `
      )
      .join('');
    resultsBox.classList.remove('hidden');
  }

  input?.addEventListener('input', (e) => {
    renderResults(e.target.value);
  });

  input?.addEventListener('focus', (e) => {
    if (e.target.value.trim()) renderResults(e.target.value);
  });

  document.addEventListener('click', (e) => {
    if (container && !container.contains(e.target)) {
      resultsBox?.classList.add('hidden');
    }
  });

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      input?.focus();
    }
    if (e.key === 'Escape') {
      resultsBox?.classList.add('hidden');
      input?.blur();
    }
  });
</script>

