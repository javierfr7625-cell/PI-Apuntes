>
  <!-- 1. Enunciado original -->
  <section>
    <h2 class="text-2xl font-bold text-white mb-3">1. Enunciado del Cliente (Mail recibido)</h2>
    <div class="rounded-xl border border-slate-800 bg-slate-900/70 p-5 text-sm space-y-3">
